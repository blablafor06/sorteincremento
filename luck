			game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = workspace.Seashells.Touch.CFrame
		end

		while tonumber(string.sub(game:GetService("Players").LocalPlayer.Stats.Pearls.Value, 3, 10)) == 0 and fahrenheit do task.wait()
			game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = workspace.Pearls.Touch.CFrame
		end

		while tonumber(string.sub(game:GetService("Players").LocalPlayer.Stats.Ash.Value, 3, 10)) == 0 and fahrenheit do task.wait()
			game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = workspace.Ash.Touch.CFrame
		end

		while tonumber(string.sub(game:GetService("Players").LocalPlayer.Stats.Igneous.Value, 3, 10)) == 0 and fahrenheit do task.wait()
			game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = workspace.Igneous.Touch.CFrame
