main:Button("Buy all Talent Tree", function()
	for i, v in pairs(game:GetService("Players").LocalPlayer.PlayerGui.TalentTreeGui.Frame.Frame.Nodes.Main:GetChildren()) do
		local args = {
		tostring(v),
			0
		}
		game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("talentRequest"):FireServer(unpack(args))
	end
	for i, v in pairs(game:GetService("Players").LocalPlayer.PlayerGui.TalentTreeGui.Frame.Frame.Nodes:GetChildren()) do
		if v:IsA("Folder") and v.name ~= "Main" and v.name ~= "Misc" then
			local tabelaRelics = v:GetChildren()
			if tabelaRelics then
				for _, relics in pairs(tabelaRelics) do
					local args = {
					tostring(relics),
						0
					}
					game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("talentRequest"):FireServer(unpack(args))
				end
			end
		end
	end
end)

